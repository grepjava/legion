# PostgreSQL 17 from FreeBSD's packages, on Legion's native base: the
# server and its tools, without what only builds or JIT use.
#
#   legion build -t examples/base:15.1 examples/base
#   legion build -t examples/postgres:17 examples/postgres
ARG BASE=localhost/examples/base:15.1
FROM ${BASE}
RUN env ASSUME_ALWAYS_YES=yes pkg install -y postgresql17-server >/dev/null \
 && (pkg delete -fy llvm19 python312 perl5 >/dev/null 2>&1 || true) \
 && rm -f /usr/local/lib/postgresql/llvmjit* \
 && pkg clean -ay >/dev/null && rm -rf /var/db/pkg/repos /var/cache/pkg/* \
 && /usr/local/bin/postgres --version
COPY start.sh /usr/local/libexec/legion-postgres
USER postgres
ENV PGDATA=/var/db/postgres/data
EXPOSE 5432
CMD ["/bin/sh", "/usr/local/libexec/legion-postgres"]

# nginx from FreeBSD's packages. Build it with jailer:
#
#   jailer build -t examples/nginx:1 examples/static-site
FROM docker.io/freebsd/freebsd-notoolchain:15.1
RUN env ASSUME_ALWAYS_YES=yes pkg bootstrap -f >/dev/null \
 && env ASSUME_ALWAYS_YES=yes pkg install -y nginx >/dev/null \
 && pkg clean -ay >/dev/null && rm -rf /var/db/pkg/repos /var/cache/pkg/* \
 && mkdir -p /var/tmp/nginx /srv/www

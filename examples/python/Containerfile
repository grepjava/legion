# Python 3 from FreeBSD's packages, on Legion's native base: a runtime for
# an app copied onto it. Build an app's image FROM this one:
#
#   FROM localhost/examples/python:3
#   WORKDIR /app
#   COPY . .
#   CMD ["/usr/local/bin/python3", "app.py"]
#
#   legion build -t examples/base:15.1 examples/base
#   legion build -t examples/python:3 examples/python
ARG BASE=localhost/examples/base:15.1
FROM ${BASE}
RUN env ASSUME_ALWAYS_YES=yes pkg install -y python3 >/dev/null \
 && pkg clean -ay >/dev/null && rm -rf /var/db/pkg/repos /var/cache/pkg/* \
 && /usr/local/bin/python3 --version
USER nobody
CMD ["/usr/local/bin/python3"]

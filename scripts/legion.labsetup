#!/bin/sh
# What Legion's isolated tests need on a lab VM before they run, as root, from
# scripts/lab run --setup: an NFS export and an iSCSI target on loopback, which
# the storage tests only mount, the guest of the bhyve test, and the jailer of
# the handoff test. Settings for the tests go in /var/tmp/lab.env, which `run`
# reads.
set -eux

lvol=/var/tmp/lvol
target=iqn.2026-10.lan.legion:lvol
mkdir -p "$lvol/export" "$lvol/empty"

# Legion never formats a LUN, so it must hold UFS already.
makefs -t ffs -s 64m "$lvol/lun.img" "$lvol/empty"
cat > /etc/ctl.conf << EOF
portal-group pg0 {
    discovery-auth-group no-authentication
    listen 127.0.0.1
}
target "$target" {
    auth-group no-authentication
    portal-group pg0
    lun 0 {
        path $lvol/lun.img
        size 64M
    }
}
EOF
service ctld onestart
# Loaded here, waiting for it: iscsid's rc script loads it only if it is
# not there, and a load under way (ctld's modules share its dependency)
# made it fail with "already loaded", stopping the setup.
kldload -n iscsi || { sleep 1; kldload -n iscsi; }
service iscsid onestart

echo "$lvol/export -maproot=root 127.0.0.1" > /etc/exports
service rpcbind onestart
service mountd onestart
service nfsd onestart

# The guest of the bhyve test, on a volume of its own.
kldload -n vmm
sh /home/lab/tree/crates/legion-net/tests/bhyve-guest.sh /var/tmp/guest.img
# The default volmode: volmode=dev gives no device on 15.1.
zfs create -V 96m lpool/guest
dd if=/var/tmp/guest.img of=/dev/zvol/lpool/guest bs=1m
mkdir -p /var/tmp/lbhyve

# jailer for the handoff test, at the revision legion.qualify records, built
# as the lab user: its crates come from the network, as its base pull does.
jailer_rev=d682ad5e5c11d181eee20bc2a1735dadccc2a75f
# A revision's archive, whole: GitHub makes one on its first request, which
# may come back empty, so it is fetched to a file, checked and tried again.
archive() {
    i=0
    until fetch -qo /tmp/src.tar.gz "https://github.com/grepjava/$1/archive/$2.tar.gz" &&
        tar -tzf /tmp/src.tar.gz > /dev/null 2>&1; do
        i=$((i + 1))
        [ $i -lt 5 ] || { echo "no archive of $1 at $2" >&2; return 1; }
        sleep 10
    done
    chmod 644 /tmp/src.tar.gz
}
archive jailer "$jailer_rev"
su -l lab -c "rm -rf ~/jailer && mkdir ~/jailer &&
    tar -xzf /tmp/src.tar.gz -C ~/jailer --strip-components 1 &&
    cd ~/jailer && cargo build --locked --bin jailer"
test -x /home/lab/jailer/target/debug/jailer

# The previous release, v0.1.14, for the upgrade drill, at the revision
# legion.qualify records: its version commit.
previous_rev=6b3cb38ba8469b7ba92f0160fce158575837fd06
archive legion "$previous_rev"
su -l lab -c "rm -rf ~/legion-prev && mkdir ~/legion-prev &&
    tar -xzf /tmp/src.tar.gz -C ~/legion-prev --strip-components 1 &&
    cd ~/legion-prev && cargo build --locked --bin legion"
test -x /home/lab/legion-prev/target/debug/legion

cat > /var/tmp/lab.env << EOF
export LEGION_STORAGE_NFS=127.0.0.1:$lvol/export
export LEGION_SYS_NFS=127.0.0.1:$lvol/export
export LEGION_STORAGE_ISCSI='127.0.0.1 $target'
export LEGION_SYS_ISCSI='127.0.0.1 $target'
export LEGION_BHYVE_DISK=/dev/zvol/lpool/guest
export LEGION_BHYVE_LAB=/var/tmp/lbhyve
export LEGION_CLUSTER_LAB=/var/tmp/lcluster
export LEGION_PG_IMAGE=/var/tmp/legion-pg.oci.tar
export LEGION_JAILER=/home/lab/jailer/target/debug/jailer
export LEGION_PREVIOUS=/home/lab/legion-prev/target/debug/legion
export LEGION_CLUSTER_HOST=10.78.0.1
export LEGION_CLUSTER_VMS='lab2=lab@10.78.0.2 lab3=lab@10.78.0.3'
export LEGION_CLUSTER_KEY=/home/lab/.ssh/id_ed25519
export LEGION_CLUSTER_LOSE=reboot
EOF
# Chromium, for the console's browser test, from lab base 5 on: without it
# the test's precondition fails rather than the test passing unrun.
if command -v chrome > /dev/null; then
    echo "export LEGION_BROWSER=$(command -v chrome)" >> /var/tmp/lab.env
fi
# axe-core, for the console test's accessibility step, copied in by the
# run (--copy ...:/var/tmp/axe.min.js) from the console's devDependencies.
if [ -f /var/tmp/axe.min.js ]; then
    echo "export LEGION_AXE=/var/tmp/axe.min.js" >> /var/tmp/lab.env
fi

test legion handoff a_local_image_keeps_its_data_through_a_drain host cluster 3600 env:LEGION_CLUSTER_LAB env:LEGION_CLUSTER_HOST env:LEGION_CLUSTER_VMS env:LEGION_CLUSTER_KEY
test legion handoff a_local_image_keeps_its_data_through_a_cut_move host cluster 3600 env:LEGION_CLUSTER_LAB env:LEGION_CLUSTER_HOST env:LEGION_CLUSTER_VMS env:LEGION_CLUSTER_KEY
test legion handoff a_local_signature_is_what_legion_checks host cluster 3600 env:LEGION_CLUSTER_LAB env:LEGION_CLUSTER_HOST env:LEGION_CLUSTER_VMS env:LEGION_CLUSTER_KEY
test legion handoff a_local_image_goes_from_build_to_recovery host cluster 3600 env:LEGION_CLUSTER_LAB env:LEGION_CLUSTER_HOST env:LEGION_CLUSTER_VMS env:LEGION_CLUSTER_KEY
test legion handoff a_local_index_runs_each_nodes_platform host cluster 3600 env:LEGION_CLUSTER_LAB env:LEGION_CLUSTER_HOST env:LEGION_CLUSTER_VMS env:LEGION_CLUSTER_KEY
test legion examples the_examples_run_as_their_readmes_say host cluster 3600 env:LEGION_CLUSTER_LAB env:LEGION_CLUSTER_HOST env:LEGION_CLUSTER_VMS env:LEGION_CLUSTER_KEY
helper legion-net mesh serve
helper legion handoff registry
helper legion console registry
helper legion-store cluster write_throughput
# Measurements of Legion's own work on fake hosts (docs/MEASURE.md), taken
# with --release wherever the tests build, not on the lab.
helper legion-manager api watch_fan_out_by_watchers
helper legion-agent cluster endpoint_propagation_by_nodes

# Legion's manifest for scripts/qualify. See that script for the format.
project legion
scan crates/*/tests/*.rs

# What Legion's tests make, in the before/after snapshots.
own ^jail [^ ]+ /var/tmp/(l|q)
own ^jail (lsys|lnet|lvip|ladopt|lcontract)
own ^mount .*/var/tmp/(l|q)
own ^if (lsys|lnet|lvip|lbr)
own ^anchor legion/
own ^zfs [^/]+/(q[0-9]|l(jail|stand|linux|img))

env LEGION_JAIL_ZFS_ROOT @zfs@
env LEGION_IMAGE_ZFS_ROOT @zfs@
env LEGION_SYS_ZFS_ROOT @zfsmount@
env LEGION_JAIL_LINUX 1
env LEGION_EXIT_LAB @lab@/exit
env LEGION_EXIT_ZFS_ROOT @zfs@/exit
env LEGION_STORAGE_LAB @lab@/storage
env LEGION_STORAGE_ZFS_ROOT @zfs@/storage
env LEGION_ADOPT_LAB @lab@/adopt
env LEGION_ADOPT_ZFS_ROOT @zfs@/adopt

run clippy 3600 cargo clippy --workspace --all-targets -- -D warnings
run unit 3600 cargo test --workspace --no-fail-fast
run api1 1200 cargo test -p legion-manager --test api
run agent1 600 cargo test -p legion-agent --test agent
run api2 1200 cargo test -p legion-manager --test api
run agent2 600 cargo test -p legion-agent --test agent
run api3 1200 cargo test -p legion-manager --test api
run agent3 600 cargo test -p legion-agent --test agent

# Safe on a shared, public host: throwaway jails, nothing published.
test legion-jail live pods_of_jails host shared 900
test legion-jail live standalone_containers_and_build_steps host shared 900
test legion-jail live linux_images host shared 900 kld:linux64
test legion-image live pulls_from_docker_hub host shared 900
test legion-image live rootfs_copies_built_layers_and_exports_on_zfs host shared 900
test legion-image live whiteouts_and_replacements_of_flagged_files host shared 900
test legion-sys live rctl_on_child_jail host shared 300
test legion-sys live jail_memory host shared 300
test legion-sys live zfs_datasets host shared 300
test legion-sys live carp_virtual_hosts vnet shared 120 kld:carp kld:if_epair
test legion-sys live network_and_pf vnet shared 300 kld:if_bridge kld:if_epair kld:pf
test legion-sys contract real_jails host shared 120
test legion-sys contract real_zfs host shared 120
test legion-sys contract real_pf vnet shared 120 kld:pf
test legion-net live pods_on_the_bridge vnet shared 300 kld:if_bridge kld:if_epair kld:pf
test legion-net live policy_on_the_bridge vnet shared 300 kld:if_bridge kld:if_epair kld:pf
test legion-net mesh pods_across_nodes host shared 600 kld:if_bridge kld:if_epair kld:if_wg kld:pf
test legion vip the_floating_address_follows_the_leader host shared 600 kld:carp kld:if_bridge kld:if_epair
test legion adopt pods_outlive_the_daemon host shared 1800 kld:if_bridge kld:if_epair kld:if_wg kld:pf

# A disposable host: these publish ports, or need servers set up first.
test legion exit app_survives_failures host isolated 1800 kld:pf
test legion memory postgres_under_a_memory_limit host isolated 1800 env:LEGION_CLUSTER_LAB env:LEGION_PG_IMAGE
test legion storage pod_on_network_storage host isolated 900 env:LEGION_STORAGE_NFS env:LEGION_STORAGE_ISCSI
test legion-sys live network_storage host isolated 300 env:LEGION_SYS_NFS env:LEGION_SYS_ISCSI
test legion-net bhyve guest_on_the_bridge vnet isolated 900 kld:vmm env:LEGION_BHYVE_DISK env:LEGION_BHYVE_LAB

# Several disposable hosts: the lab of crates/legion/tests/common.
test legion cluster app_updates_and_survives_losing_a_node host cluster 3600 env:LEGION_CLUSTER_LAB env:LEGION_CLUSTER_HOST env:LEGION_CLUSTER_VMS env:LEGION_CLUSTER_KEY
test legion stateful postgres_moves_between_nodes host cluster 3600 env:LEGION_CLUSTER_LAB env:LEGION_CLUSTER_HOST env:LEGION_CLUSTER_VMS env:LEGION_CLUSTER_KEY env:LEGION_PG_IMAGE
test legion teams two_teams_share_a_cluster host cluster 3600 env:LEGION_CLUSTER_LAB env:LEGION_CLUSTER_HOST env:LEGION_CLUSTER_VMS env:LEGION_CLUSTER_KEY

helper legion-net mesh serve
helper legion-store cluster write_throughput

# Legion's manifest for scripts/qualify. See that script for the format.
project legion
# The previous release the upgrade drill starts from.
record previous sed -n 's/^previous_rev=//p' scripts/legion.labsetup
scan crates/*/tests/*.rs

# What Legion's tests make, in the before/after snapshots.
own ^jail [^ ]+ /var/tmp/(l|q)
own ^jail (lsys|lnet|lvip|ladopt|lcontract)
own ^mount .*/var/tmp/(l|q)
own ^if (lsys|lnet|lvip|lbr|legion0|wg0)
own ^anchor legion/
own ^anchor legion-local/[0-9a-f]
own ^if ll
own ^jail [^ ]+ /tmp/\.tmp
own ^mount .* on /tmp/\.tmp
own ^rctl jail:
own ^zfs [^/]+/(q[0-9]|l(jail|stand|linux|img))
own ^zfs [^/]+/legion-local-test
own ^zfs lpools

env LEGION_JAIL_ZFS_ROOT @zfs@
env LEGION_IMAGE_ZFS_ROOT @zfs@
env LEGION_SYS_ZFS_ROOT @zfsmount@
env LEGION_JAIL_LINUX 1
env LEGION_EXIT_LAB @lab@/exit
env LEGION_EXIT_ZFS_ROOT @zfs@/exit
env LEGION_STORAGE_LAB @lab@/storage
env LEGION_STORAGE_ZFS_ROOT @zfs@/storage
env LEGION_POOLS_LAB @lab@/pools
env LEGION_POOLS_ZFS_ROOT @zfs@/pools
env LEGION_ADOPT_LAB @lab@/adopt
env LEGION_ADOPT_ZFS_ROOT @zfs@/adopt
env LEGION_LOCAL_TEST_POOL @zfsmount@

run clippy 3600 cargo clippy --workspace --all-targets -- -D warnings
run unit 3600 cargo test --workspace --no-fail-fast
run api1 1200 cargo test -p legion-manager --test api
run agent1 600 cargo test -p legion-agent --test agent
run api2 1200 cargo test -p legion-manager --test api
run agent2 600 cargo test -p legion-agent --test agent
run api3 1200 cargo test -p legion-manager --test api
run agent3 600 cargo test -p legion-agent --test agent

# Safe on a shared, public host: throwaway jails, nothing published.
test legion-jail live pods_of_jails host shared 900
test legion-jail live standalone_containers_and_build_steps host shared 900
test legion-jail live linux_images host shared 900 kld:linux64
test legion-image live pulls_from_docker_hub host shared 900
# A measurement (PLAN.md phase 9, docs/MEASURE.md): its numbers in its log.
test legion-image live image_pulls_and_loads_by_size host shared 1800
test legion-image live rootfs_copies_built_layers_and_exports_on_zfs host shared 900
test legion-image live whiteouts_and_replacements_of_flagged_files host shared 900
test legion-sys live rctl_on_child_jail host shared 300
test legion-sys live jail_memory host shared 300
test legion-sys live zfs_datasets host shared 300
test legion-sys live carp_virtual_hosts vnet shared 120 kld:carp kld:if_epair
test legion-sys live network_and_pf vnet shared 300 kld:if_bridge kld:if_epair kld:pf
test legion-sys contract real_jails host shared 120
test legion-sys contract real_zfs host shared 120
test legion-sys contract real_pf vnet shared 120 kld:pf
test legion-net live pods_on_the_bridge vnet shared 300 kld:if_bridge kld:if_epair kld:pf
test legion-net live policy_on_the_bridge vnet shared 300 kld:if_bridge kld:if_epair kld:pf
# A measurement (PLAN.md phase 9, docs/MEASURE.md): its numbers in its log.
test legion-net live pf_updates_by_services vnet shared 900 kld:if_bridge kld:if_epair kld:pf
test legion-net mesh pods_across_nodes host shared 600 kld:if_bridge kld:if_epair kld:if_wg kld:pf
# A measurement (PLAN.md phase 9, docs/MEASURE.md): its numbers in its log.
test legion-net mesh mesh_growth_by_nodes host shared 900 kld:if_bridge kld:if_epair kld:if_wg
test legion-net mesh nodes_behind_nat_reach_each_other_through_a_relay host shared 600 kld:if_bridge kld:if_epair kld:if_wg kld:pf
test legion vip the_floating_address_follows_the_leader host shared 600 kld:carp kld:if_bridge kld:if_epair
test legion adopt pods_outlive_the_daemon host shared 1800 kld:if_bridge kld:if_epair kld:if_wg kld:pf
test legion adopt pods_outlive_a_clock_set_after_boot host isolated 900 kld:if_bridge kld:if_epair kld:if_wg kld:pf

# A disposable host: these publish ports, or need servers set up first.
test legion-sys contract real_modules host isolated 120
test legion exit app_survives_failures host isolated 1800 kld:pf
test legion memory postgres_under_a_memory_limit host isolated 1800 env:LEGION_CLUSTER_LAB env:LEGION_PG_IMAGE
test legion limits limits_hold_what_wants_more host isolated 900 env:LEGION_CLUSTER_LAB
test legion linux linux_application_images host isolated 2400 env:LEGION_CLUSTER_LAB kld:linux64
test legion vm a_vm_pod_boots_and_serves host isolated 1800 env:LEGION_CLUSTER_LAB kld:vmm
test legion storage pod_on_network_storage host isolated 900 env:LEGION_STORAGE_NFS env:LEGION_STORAGE_ISCSI
test legion storage pod_on_storage_its_node_provides host isolated 900 env:LEGION_STORAGE_TARGETS
test legion pools a_pool_losing_a_device_is_degraded_on_its_node_within_30_s host isolated 600
test legion-sys live network_storage host isolated 300 env:LEGION_SYS_NFS env:LEGION_SYS_ISCSI
test legion-net bhyve guest_on_the_bridge vnet isolated 900 kld:vmm env:LEGION_BHYVE_DISK env:LEGION_BHYVE_LAB

# `legion local` on the host itself (crates/legion/tests/local_jail.rs).
# Safe on a shared, public host: throwaway jails, and ports published only on
# a test address.
test legion local_jail real_freebsd_jail_build_run_export_workflow host shared 900
test legion local_jail run_mounts_reach_the_step_but_not_the_image host shared 600
test legion local_jail cached_steps_follow_the_layer_before_them_and_chown_keeps_setuid host shared 600
test legion local_jail stage_copies_keep_owners_archives_take_flags_and_cache_options_count host shared 600
test legion local_jail the_pods_hostname_wins_and_a_stop_ends_an_attached_run host shared 600
test legion local_jail a_signal_to_exec_ends_its_command host shared 600
test legion local_jail interrupted_builds_and_runs_leave_nothing host shared 600
test legion local_jail another_users_state_directory_is_refused_by_name host shared 300
test legion local_jail a_failing_stage_nothing_needs_does_not_run host shared 300
test legion local_jail memory_limits_each_process_not_the_container host shared 300
test legion local_jail an_sbom_lists_what_pkg_knows_of_an_image host shared 300
test legion local_jail stages_at_once_overlap_share_caches_and_fail_together host shared 300
test legion local_jail a_container_left_without_its_root_is_listed_and_removed host shared 300
test legion local_jail doctor_reports_on_the_host_and_changes_nothing host shared 120
test legion local_jail a_failed_teardown_keeps_the_address_until_it_can_go host shared 300
test legion local_jail a_ctrl_c_while_a_run_starts_ends_it host shared 900
test legion local_jail a_stop_while_a_run_starts_ends_it host shared 300
test legion local_jail pods_run_on_the_network_given_and_only_one_at_a_time host shared 300

# On ZFS, where a stage or a root is a clone, not a copy.
test legion local_jail run_mounts_reach_the_step_but_not_the_image_on_zfs host shared 600
test legion local_jail cached_steps_follow_the_layer_before_them_and_chown_keeps_setuid_on_zfs host shared 600
test legion local_jail stage_copies_keep_owners_archives_take_flags_and_cache_options_count_on_zfs host shared 600
test legion local_jail interrupted_builds_and_runs_leave_nothing_on_zfs host shared 600
test legion local_jail a_failing_stage_nothing_needs_does_not_run_on_zfs host shared 600
test legion local_jail stages_at_once_overlap_share_caches_and_fail_together_on_zfs host shared 600
test legion local_jail a_container_left_without_its_root_is_listed_and_removed_on_zfs host shared 600
test legion local_jail a_ctrl_c_while_a_run_starts_ends_it_on_zfs host shared 900
test legion local_jail a_stop_while_a_run_starts_ends_it_on_zfs host shared 600

# Publishes a port on every address the host has: disposable hosts only.
test legion local_jail a_port_given_no_address_answers_on_the_hosts_own_addresses host isolated 300

# Sets kern.elf64.fallback_brand, a sysctl of the whole host: disposable hosts only.
test legion local_jail a_static_linux_program_runs_under_linux host isolated 600

# Several disposable hosts: the lab of crates/legion/tests/common.
test legion cluster app_updates_and_survives_losing_a_node host cluster 3600 env:LEGION_CLUSTER_LAB env:LEGION_CLUSTER_HOST env:LEGION_CLUSTER_VMS env:LEGION_CLUSTER_KEY env:LEGION_CLUSTER_LOSE
test legion stateful postgres_moves_between_nodes host cluster 3600 env:LEGION_CLUSTER_LAB env:LEGION_CLUSTER_HOST env:LEGION_CLUSTER_VMS env:LEGION_CLUSTER_KEY env:LEGION_PG_IMAGE
test legion stateful a_move_cut_short_or_held_by_a_full_disk_loses_nothing host cluster 3600 env:LEGION_CLUSTER_LAB env:LEGION_CLUSTER_HOST env:LEGION_CLUSTER_VMS env:LEGION_CLUSTER_KEY env:LEGION_PG_IMAGE
test legion stateful a_drain_says_each_stage_and_refuses_a_cancel_past_the_switch_over host cluster 3600 env:LEGION_CLUSTER_LAB env:LEGION_CLUSTER_HOST env:LEGION_CLUSTER_VMS env:LEGION_CLUSTER_KEY env:LEGION_PG_IMAGE
test legion stateful postgres_is_restored_onto_replacement_hosts host cluster 3600 env:LEGION_CLUSTER_LAB env:LEGION_CLUSTER_HOST env:LEGION_CLUSTER_VMS env:LEGION_CLUSTER_KEY env:LEGION_PG_IMAGE
test legion stateful a_replicated_volume_carries_on_from_its_copy_when_its_host_is_lost host cluster 3600 env:LEGION_CLUSTER_LAB env:LEGION_CLUSTER_HOST env:LEGION_CLUSTER_VMS env:LEGION_CLUSTER_KEY env:LEGION_PG_IMAGE
test legion stateful a_replicated_volume_fails_over_on_its_own_when_its_node_is_cut_off host cluster 3600 env:LEGION_CLUSTER_LAB env:LEGION_CLUSTER_HOST env:LEGION_CLUSTER_VMS env:LEGION_CLUSTER_KEY env:LEGION_PG_IMAGE
# Scheduled snapshots and backups (TODO.MD item 1): n3 the SSH backup host.
test legion backups volumes_keep_scheduled_snapshots_and_backups_that_restore host cluster 2400 env:LEGION_CLUSTER_LAB env:LEGION_CLUSTER_HOST env:LEGION_CLUSTER_VMS env:LEGION_CLUSTER_KEY
# pf set up by legion doctor --fix pf (TODO.MD item 3), on n2's pf.conf, put back after.
test legion pf_fix doctor_puts_pf_right_asks_first_and_changes_nothing_twice host cluster 900 env:LEGION_CLUSTER_LAB env:LEGION_CLUSTER_HOST env:LEGION_CLUSTER_VMS env:LEGION_CLUSTER_KEY
# Apps of the daemonless catalog (TODO.MD item 5): needs the internet.
test legion apps apps_of_the_catalog_deploy_and_answer host cluster 2400 env:LEGION_CLUSTER_LAB
# The web console in a headless Chromium (CONSOLE.md, phases 1 to 6), and two
# clusters signed into with one identity provider (phase 6's "done when").
test legion console the_console_runs_the_cluster host cluster 3600 env:LEGION_CLUSTER_LAB env:LEGION_CLUSTER_HOST env:LEGION_CLUSTER_VMS env:LEGION_CLUSTER_KEY env:LEGION_BROWSER env:LEGION_AXE
test legion console the_console_spans_two_clusters_by_single_sign_on host cluster 1800 env:LEGION_CLUSTER_LAB env:LEGION_CLUSTER_HOST env:LEGION_CLUSTER_VMS env:LEGION_CLUSTER_KEY env:LEGION_BROWSER
test legion console the_console_builds_an_example host cluster 3600 env:LEGION_CLUSTER_LAB env:LEGION_CLUSTER_HOST env:LEGION_CLUSTER_VMS env:LEGION_CLUSTER_KEY env:LEGION_BROWSER
test legion teams two_teams_share_a_cluster host cluster 3600 env:LEGION_CLUSTER_LAB env:LEGION_CLUSTER_HOST env:LEGION_CLUSTER_VMS env:LEGION_CLUSTER_KEY
test legion ca the_ca_rotates_with_every_node_on_it host cluster 3600 env:LEGION_CLUSTER_LAB env:LEGION_CLUSTER_HOST env:LEGION_CLUSTER_VMS env:LEGION_CLUSTER_KEY
test legion roles a_worker_and_a_manager_change_roles_in_place host cluster 3600 env:LEGION_CLUSTER_LAB env:LEGION_CLUSTER_HOST env:LEGION_CLUSTER_VMS env:LEGION_CLUSTER_KEY
test legion balancer a_load_balancer_address_answers_and_moves host cluster 3600 env:LEGION_CLUSTER_LAB env:LEGION_CLUSTER_HOST env:LEGION_CLUSTER_VMS env:LEGION_CLUSTER_KEY kld:carp
test legion cluster the_cluster_upgrades_one_node_at_a_time host cluster 3600 env:LEGION_CLUSTER_LAB env:LEGION_CLUSTER_HOST env:LEGION_CLUSTER_VMS env:LEGION_CLUSTER_KEY env:LEGION_PREVIOUS
test legion notify a_node_down_reaches_a_webhook_once_across_a_change_of_leader host cluster 1800 env:LEGION_CLUSTER_LAB env:LEGION_CLUSTER_HOST env:LEGION_CLUSTER_VMS env:LEGION_CLUSTER_KEY
